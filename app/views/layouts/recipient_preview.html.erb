<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <title><%= content_for(:title) || "#{t("brand.name")} — #{t("recipient.stage_label")}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="color-scheme" content="dark light">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "recipient", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="recipient-preview-page">
    <main class="recipient-preview-main">
      <%= yield %>
    </main>
  </body>
</html>
